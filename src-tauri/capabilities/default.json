{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's one window may do: keep its own files in the app's data folder, ask cupel's API, and open cupel's sign-in page in the person's browser. Nothing else on the machine, and nowhere else on the network.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:8814/api/v1/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://localhost:8814/app/signin?login=*"
        }
      ]
    }
  ]
}
