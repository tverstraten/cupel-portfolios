{
  "name": "cupel-portfolios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cupel, the user's application: books of strategies evaluated and optimized on the user's own machine",
  "scripts": {
    "runtime": "node scripts/fetch-pyodide.mjs && node scripts/bundle-core.mjs",
    "fetch-spec": "node scripts/fetch-spec.mjs",
    "dev": "vite",
    "build": "node scripts/bundle-core.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:core": "node core/tests/run_pyodide.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/app.e2e.mjs tests/e2e/exe.e2e.mjs",
    "tauri": "tauri",
    "build:exe": "tauri build --no-bundle",
    "build:test-exe": "node scripts/build-test-exe.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "pyodide": "314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.2"
  }
}
